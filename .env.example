# Copy to .env and fill in. .env is git-ignored — never commit real keys.

# --- Claude on Amazon Bedrock (paid by your AWS credits) ---
# Easiest: Bedrock console -> API keys -> generate a key, paste it here.
AWS_BEARER_TOKEN_BEDROCK=
# ...or use IAM access keys instead:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- Crustdata (company data, web search, web fetch) ---
CRUSTDATA_API_KEY=

# --- neatlogs (tracing + the Coach's MCP connection) ---
NEATLOGS_API_KEY=

# --- optional tuning ---
# UW_MODELS_SMART=anthropic.claude-opus-5-5,anthropic.claude-sonnet-5,anthropic.claude-haiku-4-5
# UW_MODELS_FAST=anthropic.claude-haiku-5-5,anthropic.claude-haiku-4-5
# UW_PROMPTS=v1
# UW_MAX_SEARCHES=8
# UW_MAX_FETCHES=10
# UW_MAX_ROUNDS=2
# UW_CHAOS=0
