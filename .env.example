# Copy to .env and fill in. .env is git-ignored. Never put real keys in THIS file (it is committed).

# --- LLMs (free tiers, no card needed). Set at least one. ---
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# Cerebras (optional extra fallback): https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# --- Crustdata (company data, web search, web fetch) ---
CRUSTDATA_API_KEY=

# --- neatlogs (tracing + the Coach's MCP connection) ---
NEATLOGS_API_KEY=

# --- optional: Claude on Amazon Bedrock (only if your AWS allowance covers Bedrock) ---
# AWS_BEARER_TOKEN_BEDROCK=
# AWS_REGION=us-east-1

# --- optional tuning ---
# UW_MODELS_SMART=gemini:gemini-3.8-flash,gemini:gemini-3.5-flash,groq:openai/gpt-oss-120b
# UW_MODELS_FAST=gemini:gemini-3.5-flash-lite,gemini:gemini-3.1-flash-lite,groq:openai/gpt-oss-20b
# UW_PROMPTS=v1
# UW_MAX_SEARCHES=8
# UW_MAX_FETCHES=8
# UW_MAX_ROUNDS=2
# UW_CHAOS=0
