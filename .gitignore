# secrets
.env
.env.*
!.env.example

# python
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# local run data (API responses cached to save credits)
.cache/
runs/*/raw/

# os / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# run state holds copied third-party page text; keep memos/events/evals as evidence, not raw pages
runs/**/state.json
runs/**/memo.pdf

# Underwrite Live's job queue (salted visitor hashes): stays on the server
runs/web/

# demo video + thumbnail (uploaded to X / YouTube, too big for git)
submission/*.mp4
submission/video-thumbnail.png
